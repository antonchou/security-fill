# dev | production — production enforces a strong APP_SECRET, disables the
# demo seed, and marks the session cookie Secure
ENVIRONMENT=dev
# Required in production; generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=
DATA_DIR=./data
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Upload caps (bytes)
MAX_KNOWLEDGE_UPLOAD_BYTES=20971520
MAX_QUESTIONNAIRE_UPLOAD_BYTES=10485760

# Optional LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Demo seed user
SEED_DEMO=1
DEMO_EMAIL=demo@securityfill.local
DEMO_PASSWORD=demo1234

# Stripe (optional — empty = mock checkout upgrades to Pro instantly)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
PRO_PRICE_DISPLAY=$49/mo
